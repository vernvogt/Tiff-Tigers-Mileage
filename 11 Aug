:"30-Nov"}],"12":[{"idx":48,"label":"7-Dec"},{"idx":49,"label":"14-Dec"},{"idx":50,"label":"21-Dec"},{"idx":51,"label":"28-Dec"}]},"2026":{"1":[{"idx":0,"label":"4-Jan"},{"idx":1,"label":"11-Jan"},{"idx":2,"label":"18-Jan"},{"idx":3,"label":"25-Jan"}],"2":[{"idx":4,"label":"1-Feb"},{"idx":5,"label":"8-Feb"},{"idx":6,"label":"15-Feb"},{"idx":7,"label":"22-Feb"}],"3":[{"idx":8,"label":"1-Mar"},{"idx":9,"label":"8-Mar"},{"idx":10,"label":"15-Mar"},{"idx":11,"label":"22-Mar"},{"idx":12,"label":"29-Mar"}],"4":[{"idx":13,"label":"5-Apr"},{"idx":14,"label":"12-Apr"},{"idx":15,"label":"19-Apr"},{"idx":16,"label":"26-Apr"}],"5":[{"idx":17,"label":"3-May"},{"idx":18,"label":"10-May"},{"idx":19,"label":"17-May"},{"idx":20,"label":"24-May"},{"idx":21,"label":"31-May"}],"6":[{"idx":22,"label":"7-Jun"},{"idx":23,"label":"14-Jun"},{"idx":24,"label":"21-Jun"},{"idx":25,"label":"28-Jun"}],"7":[{"idx":26,"label":"5-Jul"},{"idx":27,"label":"12-Jul"},{"idx":28,"label":"19-Jul"},{"idx":29,"label":"26-Jul"}],"8":[{"idx":30,"label":"2-Aug"},{"idx":31,"label":"9-Aug"},{"idx":32,"label":"16-Aug"},{"idx":33,"label":"23-Aug"},{"idx":34,"label":"30-Aug"}],"9":[{"idx":35,"label":"6-Sep"},{"idx":36,"label":"13-Sep"},{"idx":37,"label":"20-Sep"},{"idx":38,"label":"27-Sep"}],"10":[{"idx":39,"label":"4-Oct"},{"idx":40,"label":"11-Oct"},{"idx":41,"label":"18-Oct"},{"idx":42,"label":"25-Oct"}],"11":[{"idx":43,"label":"1-Nov"},{"idx":44,"label":"8-Nov"},{"idx":45,"label":"15-Nov"},{"idx":46,"label":"22-Nov"},{"idx":47,"label":"29-Nov"}],"12":[{"idx":48,"label":"6-Dec"},{"idx":49,"label":"13-Dec"},{"idx":50,"label":"20-Dec"},{"idx":51,"label":"27-Dec"}]}}}</script>
<script>
(function(){
  const DATA = JSON.parse(document.getElementById('data-blob').textContent);
  const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const YEARS = DATA.years; // [2022..2026]
  const PADDLERS = DATA.paddlers;
  const CURRENT_YEAR = YEARS[YEARS.length-1];

  // Office theme palette pulled from the workbook itself (Excel's classic
  // Accent1-6 colors), used so charts here match the ones in the spreadsheet.
  const EXCEL_PALETTE = ['#4F81BD','#C0504D','#9BBB59','#8064A2','#4BACC6','#F79646'];
  const YEAR_COLORS = {};
  YEARS.forEach((y,i)=>{ YEAR_COLORS[y] = EXCEL_PALETTE[i % EXCEL_PALETTE.length]; });

  const fmt = n => Math.round(n).toLocaleString('en-US');
  const fmt1 = n => (Math.round(n*10)/10).toLocaleString('en-US');

  // Global chart look mirrors the workbook: black/grey text, Calibri-style
  // font, light grey gridlines, white plot background.
  Chart.defaults.color = '#1A1A1A';
  Chart.defaults.font.family = "Calibri, 'Segoe UI', Arial, sans-serif";
  Chart.defaults.borderColor = '#B7B7B7';
  if (window.ChartDataLabels) Chart.unregister(window.ChartDataLabels); // opt-in per chart

  /* ---------------- TABS ---------------- */
  // Build the year tabs (newest first) into their own row.
  const tabbarYears = document.getElementById('tabbarYears');
  const yearsDesc = [...YEARS].sort((a,b)=>b-a);
  const yearTabsHtml = yearsDesc.map((y,i)=>
    `<button class="tab-btn${i===0?' active':''}" data-tab="year" data-year="${y}">${y}</button>`
  ).join('');
  tabbarYears.innerHTML = yearTabsHtml;

  let currentYear = yearsDesc[0];

  function activateTab(btn){
    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
    btn.classList.add('active');
    const tab = btn.dataset.tab;
    if(tab==='year'){
      currentYear = parseInt(btn.dataset.year);
      document.getElementById('panel-year').classList.add('active');
      renderCurrentYearView();
    } else {
      document.getElementById('panel-'+tab).classList.add('active');
    }
  }

  document.querySelectorAll('.tab-btn').forEach(btn=>{
    btn.addEventListener('click', ()=> activateTab(btn));
  });

  /* ---------------- WAKE SVG (signature element) ---------------- */
  (function drawWake(){
    const svg = document.getElementById('wakeSvg');
    const w = 1200, h = 46;
    let paths = '';
    const colors = ['#3FA7A0','#E8A33D','#C1502E'];
    for(let i=0;i<3;i++){
      let d = `M0 ${23}`;
      const amp = 9 - i*2, freq = 0.010 + i*0.003, phase = i*40;
      for(let x=0;x<=w;x+=20){
        const y = 23 + Math.sin((x+phase)*freq)*amp + i*3;
        d += ` L${x} ${y.toFixed(1)}`;
      }
      paths += `<path d="${d}" fill="none" stroke="${colors[i]}" stroke-width="1.6" opacity="${0.55-i*0.12}"/>`;
    }
    svg.innerHTML = paths;
  })();

  /* ---------------- HELPERS ---------------- */
  function yearsFor(paddler){
    return YEARS.filter(y => DATA.byYear[y] && DATA.byYear[y][paddler]);
  }
  function clubTotalAllTime(){
    let t=0;
    YEARS.forEach(y=>{ Object.values(DATA.byYear[y]).forEach(p=> t+=p.total); });
    return t;
  }
  function clubTotalForYear(y){
    return Object.values(DATA.byYear[y]||{}).reduce((s,p)=>s+p.total,0);
  }
  function activePaddlerCount(y){
    return Object.values(DATA.byYear[y]||{}).filter(p=>p.total>0).length;
  }

  /* ---------------- HERO STATS ---------------- */
  (function heroStats(){
    const el = document.getElementById('heroStats');
    const allTime = clubTotalAllTime();
    const thisYear = clubTotalForYear(CURRENT_YEAR);
    const active = activePaddlerCount(CURRENT_YEAR);
    el.innerHTML = `
      <div class="hstat"><span class="n">${fmt(allTime)}<small>km</small></span><span class="l">All-time club distance</span></div>
      <div class="hstat"><span class="n">${fmt(thisYear)}<small>km</small></span><span class="l">${CURRENT_YEAR} distance so far</span></div>
      <div class="hstat"><span class="n">${active}</span><span class="l">Active paddlers, ${CURRENT_YEAR}</span></div>
      <div class="hstat"><span class="n">${PADDLERS.length}</span><span class="l">Paddlers on record, ${YEARS[0]}&ndash;${CURRENT_YEAR}</span></div>
    `;
  })();

  function safeChart(fn){ try{ return fn(); } catch(e){ console.error('Chart render failed:', e); return null; } }

  /* ================= YEAR VIEW TAB ================= */
  // 12-color month palette, taken directly from the workbook's own
  // "Monthly Totals" chart (6 accents + their 6 tints).
  const MONTH_COLORS = ['#4F81BD','#C0504D','#9BBB59','#8064A2','#4BACC6','#F79646',
                         '#BED1E7','#E8BFBE','#DCE7C6','#CEC4DB','#BFE2EB','#FDE9D9'];

  let chartYearMonthly;
  function renderYearChart(year){
    document.getElementById('yearViewTitle').textContent = `\u2014 ${year}`;
    document.getElementById('yearChartTag').textContent = `${year} season`;
    document.getElementById('xlYearTitle').textContent = `${year} Total KM`;

    const entries = Object.entries(DATA.byYear[year])
      .filter(([,d])=>d.total>0)
      .sort((a,b)=>b[1].total-a[1].total);
    const names = entries.map(e=>e[0]);

    // widen the scroll area so every paddler gets a readable column
    document.getElementById('chartYearMonthly').parentElement.style.minWidth = Math.max(1100, names.length*38) + 'px';

    const datasets = MONTHS.map((m,mi)=>({
      type:'bar',
      label: m,
      data: names.map(n=>Math.round(DATA.byYear[year][n].monthly[mi])),
      backgroundColor: MONTH_COLORS[mi],
      borderColor:'#000000',
      borderWidth:1,
      stack:'months',
      datalabels:{
        display: ctx => ctx.dataset.data[ctx.dataIndex] > 0,
        color: mi < 6 ? '#FFFFFF' : '#1A1A1A',
        font:{size:8, weight:'bold'},
        formatter:v=>fmt(v)
      }
    }));

    // Invisible line riding the top of each stack, purely to host the
    // bold annual-total label — same trick the workbook's own
    // "2026 Total KM" chart uses.
    datasets.push({
      type:'line',
      label:'Total',
      data: names.map(n=>Math.round(DATA.byYear[year][n].total)),
      borderColor:'rgba(0,0,0,0)',
      backgroundColor:'rgba(0,0,0,0)',
      borderWidth:0,
      pointRadius:0,
      pointHoverRadius:0,
      spanGaps:true,
      datalabels:{
        display:true,
        anchor:'end', align:'top', offset:2,
        color:'#C00000', font:{weight:'bold', size:10.5},
        formatter:v=>fmt(v)
      }
    });

    if(chartYearMonthly) chartYearMonthly.destroy();
    chartYearMonthly = safeChart(()=> new Chart(document.getElementById('chartYearMonthly'), {
      type:'bar',
      plugins: window.ChartDataLabels ? [window.ChartDataLabels] : [],
      data:{ labels: names, datasets },
      options:{
        maintainAspectRatio:false,
        plugins:{
          legend:{
            position:'bottom', labels:{
              boxWidth:12, color:'#1A1A1A', font:{size:10},
              filter: item => item.text !== 'Total'
            }
          },
          tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${fmt(c.raw)} km`}}
        },
        scales:{
          x:{ stacked:true, grid:{display:false}, border:{color:'#000000'}, ticks:{autoSkip:false, maxRotation:60, minRotation:60, font:{size:10}} },
          y:{ stacked:true, grid:{color:'#B7B7B7'}, border:{display:false}, ticks:{callback:v=>fmt(v)} }
        }
      }
    }));
  }
  renderYearChart(currentYear);

  /* ---- month sub-tabs within Season View ---- */
  const monthSubtabs = document.getElementById('monthSubtabs');
  const monthlyCard = document.getElementById('chartYearMonthly').closest('.card');
  const weeklyCard = document.getElementById('monthWeeklyCard');
  let currentMonthView = 'full'; // 'full' or 1-12

  monthSubtabs.innerHTML = `<button class="month-subtab active" data-month="full">Full Year</button>` +
    MONTHS.map((m,i)=>`<button class="month-subtab" data-month="${i+1}">${m}</button>`).join('');

  function renderCurrentYearView(){
    if(currentMonthView==='full'){
      monthlyCard.style.display='';
      weeklyCard.style.display='none';
      renderYearChart(currentYear);
    } else {
      monthlyCard.style.display='none';
      weeklyCard.style.display='';
      renderMonthWeeklyChart(currentYear, currentMonthView);
    }
  }

  monthSubtabs.querySelectorAll('.month-subtab').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      monthSubtabs.querySelectorAll('.month-subtab').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      const mv = btn.dataset.month;
      currentMonthView = mv==='full' ? 'full' : parseInt(mv);
      renderCurrentYearView();
    });
  });

  let chartMonthWeekly;
  function renderMonthWeeklyChart(year, monthIndex){
    const monthName = MONTHS[monthIndex-1];
    document.getElementById('monthChartTag').textContent = `${monthName} ${year}`;
    document.getElementById('xlMonthWeeklyTitle').textContent = `${monthName.toUpperCase()} WEEKLY TOTALS`;

    const weeks = (DATA.monthWeeks[year] && DATA.monthWeeks[year][monthIndex]) || [];
    const entries = Object.entries(DATA.byYear[year])
      .filter(([,d])=>d.total>0)
      .sort((a,b)=>b[1].total-a[1].total);
    const names = entries.map(e=>e[0]);

    document.getElementById('chartMonthWeekly').parentElement.style.minWidth = Math.max(1100, names.length*38) + 'px';

    const barDatasets = weeks.map((w,wi)=>({
      type:'bar',
      label: w.label,
      data: names.map(n=>{
        const wk = DATA.weekly[year][n];
        return wk ? Math.round(wk[w.idx]||0) : 0;
      }),
      backgroundColor: EXCEL_PALETTE[wi % EXCEL_PALETTE.length],
      borderColor:'#000000',
      borderWidth:1,
      datalabels:{display:false}
    }));

    // visible month-total line, same treatment as the workbook's own
    // teal "JUL" trend line across the weekly bars.
    const totalLine = {
      type:'line',
      label: monthName.toUpperCase(),
      data: names.map(n=> DATA.byYear[year][n] ? Math.round(DATA.byYear[year][n].monthly[monthIndex-1]) : 0),
      borderColor: MONTH_COLORS[monthIndex-1],
      backgroundColor: MONTH_COLORS[monthIndex-1],
      borderWidth:2,
      pointRadius:0,
      tension:0.15,
      datalabels:{
        display: ctx => ctx.dataset.data[ctx.dataIndex] > 0,
        anchor:'end', align:'top', offset:2,
        color:'#1A1A1A', font:{weight:'bold', size:9},
        formatter:v=>fmt(v)
      }
    };

    const datasets = [...barDatasets, totalLine];

    if(chartMonthWeekly) chartMonthWeekly.destroy();
    chartMonthWeekly = safeChart(()=> new Chart(document.getElementById('chartMonthWeekly'), {
      type:'bar',
      plugins: window.ChartDataLabels ? [window.ChartDataLabels] : [],
      data:{ labels: names, datasets },
      options:{
        maintainAspectRatio:false,
        plugins:{
          legend:{position:'bottom', labels:{boxWidth:12, color:'#1A1A1A', font:{size:10}}},
          tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${fmt(c.raw)} km`}}
        },
        scales:{
          x:{ grid:{display:false}, border:{color:'#000000'}, ticks:{autoSkip:false, maxRotation:60, minRotation:60, font:{size:10}} },
          y:{ grid:{color:'#B7B7B7'}, border:{display:false}, ticks:{callback:v=>fmt(v)} }
        }
      }
    }));
  }

  weeklyCard.style.display='none';

  /* ================= EXPLORER TAB ================= */
  const selPaddler = document.getElementById('selPaddler');
  const selYear = document.getElementById('selYear');
  selPaddler.innerHTML = PADDLERS.map(p=>`<option value="${p}">${p}</option>`).join('');

  let chartMonthly, chartYoy;

  function populateYearOptions(paddler){
    const ys = yearsFor(paddler);
    selYear.innerHTML = ys.map(y=>`<option value="${y}">${y}</option>`).join('');
    selYear.value = ys[ys.length-1];
  }

  function renderMonthlyTable(paddler, year){
    const d = DATA.byYear[year][paddler];
    const tbl = document.getElementById('tblMonthly');
    let rows = MONTHS.map((m,i)=>{
      const v = d.monthly[i];
      return `<tr><td>${m}</td><td class="${v===0?'zero':''}">${fmt1(v)}</td></tr>`;
    }).join('');
    tbl.innerHTML = `<thead><tr><th>Month</th><th>Km</th></tr></thead><tbody>${rows}
      <tr class="total-row"><td>Total</td><td>${fmt1(d.total)}</td></tr></tbody>`;
    document.getElementById('expMonthTag').textContent = `${paddler} \u2014 ${year}`;
  }

  function renderMonthlyChart(paddler, year){
    const d = DATA.byYear[year][paddler];
    const cum = cumulative(d.monthly);
    if(chartMonthly) chartMonthly.destroy();
    document.getElementById('xlMonthlyTitle').textContent = `${paddler} \u2014 Monthly Totals, ${year}`;
    chartMonthly = safeChart(()=> new Chart(document.getElementById('chartMonthly'), {
      type:'bar',
      plugins: window.ChartDataLabels ? [window.ChartDataLabels] : [],
      data:{ labels: MONTHS, datasets:[
        {
          type:'bar',
          label:'Monthly',
          data: d.monthly.map(v=>Math.round(v*10)/10),
          backgroundColor: '#4F81BD',
          borderColor:'#000000',
          borderWidth:1,
          maxBarThickness:34,
          yAxisID:'y',
          datalabels:{
            anchor:'end', align:'top', color:'#1A1A1A',
            font:{weight:'bold', size:10},
            formatter:v=> v>0 ? fmt1(v) : ''
          }
        },
        {
          type:'line',
          label:'Cumulative',
          data: cum,
          borderColor:'#C00000',
          backgroundColor:'#C00000',
          borderWidth:2,
          pointRadius:3,
          pointHoverRadius:5,
          tension:0.2,
          yAxisID:'y1',
          datalabels:{
            display: ctx => ctx.dataset.data[ctx.dataIndex] > 0,
            anchor:'end', align:'top', offset:4,
            color:'#C00000',
            font:{weight:'bold', size:9.5},
            formatter:v=>fmt(v)
          }
        }
      ]},
      options:{
        plugins:{
          legend:{position:'bottom', labels:{boxWidth:14, color:'#1A1A1A'}},
          tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${fmt1(c.raw)} km`}},
          datalabels:{
            anchor:'end', align:'top', color:'#1A1A1A',
            font:{weight:'bold', size:10},
            formatter:v=> v>0 ? fmt1(v) : ''
          }
        },
        scales:{
          x:{grid:{display:false}, border:{color:'#000000'}},
          y:{grid:{color:'#B7B7B7'}, border:{display:false}},
          y1:{ position:'right', grid:{display:false}, border:{display:false}, ticks:{callback:v=>fmt(v)} }
        }
      }
    }));
  }

  function renderYoyTable(paddler){
    const ys = yearsFor(paddler);
    let rows = ys.map(y=>`<tr><td>${y}</td><td>${fmt1(DATA.byYear[y][paddler].total)}</td></tr>`).join('');
    const grand = ys.reduce((s,y)=>s+DATA.byYear[y][paddler].total,0);
    document.getElementById('tblYoy').innerHTML =
      `<thead><tr><th>Year</th><th>Km</th></tr></thead><tbody>${rows}
       <tr class="total-row"><td>Career</td><td>${fmt1(grand)}</td></tr></tbody>`;
    document.getElementById('expYoyTag').textContent = paddler;
  }

  function renderYoyChart(paddler){
    const ys = yearsFor(paddler);
    if(chartYoy) chartYoy.destroy();
    document.getElementById('xlYoyTitle').textContent = `${paddler} \u2014 Annual Comparison`;
    const datasets = ys.map(y=>({
      label: String(y),
      data: DATA.byYear[y][paddler].monthly.map(v=>Math.round(v)),
      backgroundColor: YEAR_COLORS[y],
      borderColor:'#000000',
      borderWidth:1
    }));
    chartYoy = safeChart(()=> new Chart(document.getElementById('chartYoy'), {
      type:'bar',
      plugins: window.ChartDataLabels ? [window.ChartDataLabels] : [],
      data:{ labels: MONTHS, datasets },
      options:{
        plugins:{
          legend:{position:'bottom', labels:{boxWidth:14, color:'#1A1A1A'}},
          tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${fmt(c.raw)} km`}},
          datalabels:{
            display:ctx=>ctx.dataset.data[ctx.dataIndex]>0,
            anchor:'end', align:'top', color:'#1A1A1A',
            font:{size:8}, formatter:v=>fmt(v)
          }
        },
        scales:{
          x:{grid:{display:false}, border:{color:'#000000'}},
          y:{grid:{color:'#B7B7B7'}, border:{display:false}}
        }
      }
    }));
  }

  function refreshExplorer(){
    const paddler = selPaddler.value;
    const year = parseInt(selYear.value);
    renderMonthlyTable(paddler, year);
    renderMonthlyChart(paddler, year);
    renderYoyTable(paddler);
    renderYoyChart(paddler);
  }

  selPaddler.addEventListener('change', ()=>{ populateYearOptions(selPaddler.value); refreshExplorer(); });
  selYear.addEventListener('change', refreshExplorer);

  // init default: Vern if present else first paddler
  selPaddler.value = PADDLERS.includes('Vern') ? 'Vern' : PADDLERS[0];
  populateYearOptions(selPaddler.value);
  refreshExplorer();

  /* ================= WORM COMPARISON TAB ================= */
  function careerTotal(name){
    return YEARS.reduce((s,y)=> s + (DATA.byYear[y][name] ? DATA.byYear[y][name].total : 0), 0);
  }

  function cumulative(arr){
    let s=0; return arr.map(v=>{ s+=v; return Math.round(s*10)/10; });
  }

  // Generic paddler multi-select picker: filter box + chips + checklist.
  // Returns {selected, mount} so any tab can spin up its own instance.
  function createPaddlerPicker({filterId, chipsId, listId, defaults, onChange}){
    const selected = new Set(defaults);
    const filterEl = document.getElementById(filterId);
    const chipsEl = document.getElementById(chipsId);
    const listEl = document.getElementById(listId);

    function renderChips(){
      const names = [...selected];
      chipsEl.innerHTML = names.length ? names.map(n=>
        `<div class="worm-chip">${n}<button data-name="${n}" aria-label="Remove ${n}">&times;</button></div>`
      ).join('') : `<span style="color:var(--foam-dim); font-size:13px;">No paddlers selected yet &mdash; tick some below.</span>`;
      chipsEl.querySelectorAll('button').forEach(btn=>{
        btn.addEventListener('click', ()=>{
          selected.delete(btn.dataset.name);
          renderChips(); renderList(filterEl.value); onChange();
        });
      });
    }

    function renderList(filterText){
      const ft = (filterText||'').trim().toLowerCase();
      const list = PADDLERS.filter(n=>n.toLowerCase().includes(ft));
      listEl.innerHTML = list.map(n=>{
        const checked = selected.has(n);
        const total = fmt(careerTotal(n));
        return `<label class="worm-check-item${checked?' checked':''}">
          <input type="checkbox" value="${n}" ${checked?'checked':''}>
          <span>${n}<br><small style="color:var(--foam-dim); font-weight:400;">${total} km career</small></span>
        </label>`;
      }).join('');
      listEl.querySelectorAll('input').forEach(cb=>{
        cb.addEventListener('change', ()=>{
          if(cb.checked) selected.add(cb.value);
          else selected.delete(cb.value);
          renderChips(); onChange();
        });
      });
    }

    filterEl.addEventListener('input', ()=> renderList(filterEl.value));
    renderChips();
    renderList('');
    return { selected, refresh: ()=>{ renderChips(); renderList(filterEl.value); } };
  }

  function renderWorm(canvasId, paddler){
    const datasets = YEARS.filter(y=>DATA.byYear[y][paddler]).map(y=>{
      const monthly = DATA.byYear[y][paddler].monthly;
      const cum = cumulative(monthly);

      return {
        label: String(y),
        data: cum,
        borderColor: YEAR_COLORS[y],
        backgroundColor: YEAR_COLORS[y],
        pointRadius:3,
        pointHoverRadius:5,
        borderWidth: y===CURRENT_YEAR ? 3 : 1.5,
        tension:0.2,
        datalabels:{
          display: ctx => ctx.dataset.data[ctx.dataIndex] > 0,
          align:'top', anchor:'end', offset:2,
          color: YEAR_COLORS[y],
          font:{size:9, weight:'bold'},
          formatter:v=>fmt(v)
        }
      };
    });
    return safeChart(()=> new Chart(document.getElementById(canvasId), {
      type:'line',
      plugins: window.ChartDataLabels ? [window.ChartDataLabels] : [],
      data:{ labels: MONTHS, datasets },
      options:{
        interaction:{mode:'index', intersect:false},
        plugins:{
          legend:{position:'bottom', labels:{boxWidth:14, color:'#1A1A1A'}},
          tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${fmt(c.raw)} km`}}
        },
        scales:{
          x:{ grid:{display:false}, border:{color:'#000000'} },
          y:{ grid:{color:'#B7B7B7'}, border:{display:false}, ticks:{callback:v=>fmt(v)} }
        }
      }
    }));
  }

  function renderGrid(tblId, paddler){
    const rows = MONTHS.map((m,mi)=>{
      const cells = YEARS.map(y=>{
        const d = DATA.byYear[y][paddler];
        const v = d ? d.monthly[mi] : null;
        return `<td class="${(!v)?'zero':''}">${v===null?'&mdash;':fmt1(v)}</td>`;
      }).join('');
      return `<tr><td>${m}</td>${cells}</tr>`;
    }).join('');
    const totalCells = YEARS.map(y=>{
      const d = DATA.byYear[y][paddler];
      return `<td>${d?fmt1(d.total):'&mdash;'}</td>`;
    }).join('');
    document.getElementById(tblId).innerHTML =
      `<thead><tr><th>Month</th>${YEARS.map(y=>`<th>${y}</th>`).join('')}</tr></thead>
       <tbody>${rows}<tr class="total-row"><td>Total</td>${totalCells}</tr></tbody>`;
  }

  let chartWormYoy;
  function renderWormYoyChart(){
    const names = [...wormPicker.selected];
    const datasets = names.map((n,i)=>({
      label:n,
      data: YEARS.map(y=> DATA.byYear[y][n] ? Math.round(DATA.byYear[y][n].total) : 0),
      backgroundColor: EXCEL_PALETTE[i % EXCEL_PALETTE.length],
      borderColor:'#000000',
      borderWidth:1
    }));
    if(chartWormYoy) chartWormYoy.destroy();
    chartWormYoy = safeChart(()=> new Chart(document.getElementById('chartWormYoy'), {
      type:'bar',
      plugins: window.ChartDataLabels ? [window.ChartDataLabels] : [],
      data:{ labels: YEARS, datasets },
      options:{
        plugins:{
          legend:{position:'bottom', labels:{boxWidth:14, color:'#1A1A1A'}},
          tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${fmt(c.raw)} km`}},
          datalabels:{
            display:ctx=>ctx.dataset.data[ctx.dataIndex]>0,
            anchor:'end', align:'top', color:'#1A1A1A', font:{size:9},
            formatter:v=>fmt(v)
          }
        },
        scales:{
          x:{grid:{display:false}, border:{color:'#000000'}},
          y:{grid:{color:'#B7B7B7'}, border:{display:false}, ticks:{callback:v=>fmt(v)}}
        }
      }
    }));
  }

  function renderWormCharts(){
    const container = document.getElementById('wormChartsContainer');
    const names = [...wormPicker.selected];
    if(!names.length){
      container.innerHTML = `<p class="section-sub">Select at least one paddler above to see their mileage worm.</p>`;
      return;
    }
    container.innerHTML = names.map((n,i)=>`
      <div class="worm-paddler-block">
        <div class="worm-paddler-name">${n}</div>
        <div class="card" style="margin-bottom:14px;">
          <h3>Mileage worm <span class="tag">cumulative km, month of year</span></h3>
          <div class="xl-frame">
            <div class="xl-title">${n} &mdash; Monthly Cumulative Totals</div>
            <canvas id="worm_canvas_${i}" height="220"></canvas>
          </div>
        </div>
        <div class="card">
          <h3>Monthly by year</h3>
          <table class="data" id="worm_table_${i}"></table>
        </div>
      </div>
    `).join('');
    names.forEach((n,i)=>{
      renderWorm(`worm_canvas_${i}`, n);
      renderGrid(`worm_table_${i}`, n);
    });
  }

  function refreshWormTab(){
    renderWormYoyChart();
    renderWormCharts();
  }

  const wormDefaults = ['Vern','Keegan'].filter(n=>PADDLERS.includes(n));
  const wormPicker = createPaddlerPicker({
    filterId:'wormFilter', chipsId:'wormChips', listId:'wormCheckList',
    defaults: wormDefaults.length ? wormDefaults : PADDLERS.slice(0,2),
    onChange: refreshWormTab
  });
  refreshWormTab();

  /* ================= COMPARE PADDLERS (Explorer tab) ================= */
  const compareYearSel = document.getElementById('compareYear');
  compareYearSel.innerHTML = [...YEARS].sort((a,b)=>b-a).map(y=>`<option value="${y}">${y}</option>`).join('');

  let chartCompareMonthly, chartCompareAnnual;

  function renderCompareMonthly(){
    const names = [...comparePicker.selected];
    const year = parseInt(compareYearSel.value);
    document.getElementById('compareMonthTag').textContent = `${year}`;
    document.getElementById('xlCompareMonthlyTitle').textContent = `Monthly Totals, ${year}`;
    const datasets = names.map((n,i)=>({
      label:n,
      data: DATA.byYear[year][n] ? DATA.byYear[year][n].monthly.map(v=>Math.round(v)) : MONTHS.map(()=>0),
      backgroundColor: EXCEL_PALETTE[i % EXCEL_PALETTE.length],
      borderColor:'#000000',
      borderWidth:1
    }));
    if(chartCompareMonthly) chartCompareMonthly.destroy();
    chartCompareMonthly = safeChart(()=> new Chart(document.getElementById('chartCompareMonthly'), {
      type:'bar',
      data:{ labels: MONTHS, datasets },
      options:{
        plugins:{
          legend:{position:'bottom', labels:{boxWidth:14, color:'#1A1A1A'}},
          tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${fmt(c.raw)} km`}}
        },
        scales:{
          x:{grid:{display:false}, border:{color:'#000000'}},
          y:{grid:{color:'#B7B7B7'}, border:{display:false}, ticks:{callback:v=>fmt(v)}}
        }
      }
    }));
  }

  function renderCompareAnnual(){
    const names = [...comparePicker.selected];
    const datasets = names.map((n,i)=>({
      label:n,
      data: YEARS.map(y=> DATA.byYear[y][n] ? Math.round(DATA.byYear[y][n].total) : 0),
      backgroundColor: EXCEL_PALETTE[i % EXCEL_PALETTE.length],
      borderColor:'#000000',
      borderWidth:1
    }));
    if(chartCompareAnnual) chartCompareAnnual.destroy();
    chartCompareAnnual = safeChart(()=> new Chart(document.getElementById('chartCompareAnnual'), {
      type:'bar',
      plugins: window.ChartDataLabels ? [window.ChartDataLabels] : [],
      data:{ labels: YEARS, datasets },
      options:{
        plugins:{
          legend:{position:'bottom', labels:{boxWidth:14, color:'#1A1A1A'}},
          tooltip:{callbacks:{label:c=>`${c.dataset.label}: ${fmt(c.raw)} km`}},
          datalabels:{
            display:ctx=>ctx.dataset.data[ctx.dataIndex]>0,
            anchor:'end', align:'top', color:'#1A1A1A', font:{size:9},
            formatter:v=>fmt(v)
          }
        },
        scales:{
          x:{grid:{display:false}, border:{color:'#000000'}},
          y:{grid:{color:'#B7B7B7'}, border:{display:false}, ticks:{callback:v=>fmt(v)}}
        }
      }
    }));
  }

  function refreshCompareTab(){
    renderCompareMonthly();
    renderCompareAnnual();
  }

  const comparePicker = createPaddlerPicker({
    filterId:'compareFilter', chipsId:'compareChips', listId:'compareCheckList',
    defaults: wormDefaults.length ? wormDefaults : PADDLERS.slice(0,2),
    onChange: refreshCompareTab
  });
  compareYearSel.addEventListener('change', refreshCompareTab);
  refreshCompareTab();

})();

</script>
</body>
</html>
